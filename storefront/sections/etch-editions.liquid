{% comment %}
  Etch editions — the curated looks as an editorial gallery: tall 2:3 artwork
  cards with a serif name and one line beneath, gallery-label style. Cards show
  a quiet material ground until artwork images are uploaded.
{% endcomment %}

{{ 'etch.css' | asset_url | stylesheet_tag }}

{%- style -%}
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }
  {%- if section.blocks.size > 0 -%}
  .section-{{ section.id }}-padding .etch-editions {
    --etch-editions-columns: {{ section.settings.columns }};
  }
  {%- endif -%}
  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }
{%- endstyle -%}

<div class="color-{{ section.settings.color_scheme }} gradient">
  <div class="page-width section-{{ section.id }}-padding">
    <header style="margin-bottom: 5.6rem; max-width: 70rem;">
      {%- if section.settings.eyebrow != blank -%}
        <span class="etch-eyebrow">{{ section.settings.eyebrow }}</span>
      {%- endif -%}
      {%- if section.settings.heading != blank -%}
        <h2 class="h1" style="margin: 0;">{{ section.settings.heading }}</h2>
      {%- endif -%}
      {%- if section.settings.text != blank -%}
        <div class="etch-lede rte" style="margin-top: 2rem;">{{ section.settings.text }}</div>
      {%- endif -%}
    </header>
    <div class="etch-editions">
      {%- for block in section.blocks -%}
        <figure class="etch-edition" {{ block.shopify_attributes }}>
          <div class="etch-edition__media">
            {%- if block.settings.image != blank -%}
              {{
                block.settings.image
                | image_url: width: 900
                | image_tag: loading: 'lazy', widths: '400, 600, 900', sizes: '(min-width: 990px) 30vw, (min-width: 750px) 45vw, 92vw'
              }}
            {%- endif -%}
          </div>
          <figcaption>
            <h3 class="etch-edition__name">{{ block.settings.name }}</h3>
            {%- if block.settings.line != blank -%}
              <p class="etch-edition__line">{{ block.settings.line }}</p>
            {%- endif -%}
          </figcaption>
        </figure>
      {%- endfor -%}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Etch editions",
  "tag": "section",
  "class": "section",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "The editions" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Choose a finished look, not a template." },
    { "type": "richtext", "id": "text", "label": "Text" },
    { "type": "range", "id": "columns", "min": 2, "max": 4, "step": 1, "label": "Columns on desktop", "default": 3 },
    { "type": "color_scheme", "id": "color_scheme", "label": "Color scheme", "default": "scheme-3" },
    { "type": "range", "id": "padding_top", "min": 0, "max": 160, "step": 4, "unit": "px", "label": "Top padding", "default": 88 },
    { "type": "range", "id": "padding_bottom", "min": 0, "max": 160, "step": 4, "unit": "px", "label": "Bottom padding", "default": 88 }
  ],
  "blocks": [
    {
      "type": "edition",
      "name": "Edition",
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Artwork image" },
        { "type": "text", "id": "name", "label": "Name", "default": "Streets" },
        { "type": "text", "id": "line", "label": "Line", "default": "Just the streets, in pale grey — the route inked over." }
      ]
    }
  ],
  "max_blocks": 8,
  "presets": [
    {
      "name": "Etch editions",
      "blocks": [{ "type": "edition" }, { "type": "edition" }, { "type": "edition" }]
    }
  ]
}
{% endschema %}
