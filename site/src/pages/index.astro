---
import Base from '../layouts/Base.astro';
import NwatLockup from '../components/NwatLockup.astro';
import NwatIcon from '../components/NwatIcon.astro';
import OrgChart from '../components/OrgChart.astro';
import { subsidiaries, former, corporate } from '../data/entities';
import css from '../styles/corporate.css?raw';

const fonts = `<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Archivo:wdth,wght@75..100,400..700&family=Newsreader:opsz,wght@6..72,300..500&display=swap">`;

const cls = { Operating: 'op', 'In evaluation': 'ev', Discontinued: 'di' } as const;
---
<Base
  title="Northwest Ag Technologies"
  description="Northwest Ag Technologies, L.L.C. is a privately held company owning and operating businesses in agricultural services and software development."
  css={css}
  fonts={fonts}
  themeColor="#F7F6F1"
>
<nav><div class="navin">
  <a class="navmark" href="/"><NwatLockup /></a>
  <div class="navlinks">
    <a href="#structure">Structure</a><a href="#companies">Companies</a>
    <a href="#investments">Investments</a><a href="#corporate">Corporate</a>
    <a href="#contact">Contact</a>
  </div>
</div></nav>

<main>
  <div class="shell"><header class="hero">
    <p class="label">Northwest Ag Technologies, L.L.C.</p>
    <h1>A privately held company operating businesses in agriculture and software.</h1>
    <p class="lede">Northwest Ag Technologies owns, operates and capitalises its subsidiaries.
    Each one runs under its own name, serves its own customers, and is accountable for its own
    results. The parent holds the entity, sets the standard they build to, and decides what the
    company takes on next.</p>
  </header></div>

  <div class="shell"><section id="structure">
    <div class="sechead"><span class="label">Structure</span>
      <h2>One parent. Independent operating companies beneath it.</h2>
      <p class="body">Subsidiaries are not divisions. They carry their own brands and their own
      customer relationships, which is why a soil sampling client and a software client have no
      reason to meet each other.</p></div>
    <div class="chartwrap"><OrgChart /></div>
  </section></div>

  <div class="shell"><section id="companies">
    <div class="sechead"><span class="label">Operating companies</span>
      <h2>What the company owns today.</h2></div>
    <table>
      <thead><tr><th>Company</th><th>Sector</th><th>Principal office</th><th>Status</th></tr></thead>
      <tbody>
        {subsidiaries.map((s) => (
          <tr>
            <td class="nm">{s.href ? <a href={s.href}>{s.name}</a> : s.name}
              {s.note && <span class="note">{s.note}</span>}</td>
            <td>{s.sector}</td>
            <td>{s.office}</td>
            <td><span class={`st ${cls[s.status]}`}>{s.status}</span></td>
          </tr>
        ))}
      </tbody>
    </table>

    <table style="margin-top:clamp(34px,4vw,52px)">
      <caption>Former operations</caption>
      <thead><tr><th>Business</th><th>Sector</th><th>Principal office</th><th>Status</th></tr></thead>
      <tbody>
        {former.map((s) => (
          <tr>
            <td class="nm">{s.name}{s.note && <span class="note">{s.note}</span>}</td>
            <td>{s.sector}</td>
            <td>{s.office}</td>
            <td><span class={`st ${cls[s.status]}`}>{s.status}</span></td>
          </tr>
        ))}
      </tbody>
    </table>
  </section></div>

  <div class="shell"><section id="investments">
    <div class="sechead"><span class="label">Investments</span>
      <h2>Interests held outside the operating companies.</h2>
      <p class="body">Where Northwest Ag Technologies holds a position in a business it does
      not operate, it is listed here, subject to what the counterparty permits us to disclose.</p></div>
    <dl class="facts">
      <dt>Current holdings</dt>
      <dd><span class="slot">To be listed</span></dd>
      <dt>Investment enquiries</dt>
      <dd><a href={`mailto:${corporate.general}`}>{corporate.general}</a></dd>
    </dl>
  </section></div>

  <div class="shell"><section id="corporate">
    <div class="sechead"><span class="label">Corporate</span>
      <h2>Entity and offices.</h2></div>
    <dl class="facts">
      <dt>Legal name</dt><dd>{corporate.legalName}</dd>
      <dt>Entity type</dt><dd>{corporate.entityType}</dd>
      <dt>Jurisdiction of formation</dt>
      <dd>{corporate.jurisdiction ?? <span class="slot">To be confirmed</span>}</dd>
      <dt>Formed</dt>
      <dd>{corporate.formed ?? <span class="slot">To be confirmed</span>}</dd>
      <dt>Principal offices</dt><dd>{corporate.offices.join(' · ')}</dd>
      <dt>Registered agent</dt><dd><span class="slot">To be confirmed</span></dd>
    </dl>
  </section></div>

  <div class="shell"><section id="contact">
    <div class="sechead"><span class="label">Contact</span>
      <h2>Corporate enquiries.</h2>
      <p class="body">Business, investor and legal correspondence goes to the general address.
      Anything to do with software reaches Verde House directly.</p></div>
    <dl class="facts">
      <dt>General, investor &amp; legal</dt>
      <dd><a href={`mailto:${corporate.general}`}>{corporate.general}</a></dd>
      <dt>Software — Verde House</dt>
      <dd><a href={`mailto:${corporate.software}`}>{corporate.software}</a></dd>
      <dt>Offices</dt><dd>{corporate.offices.join(' · ')}</dd>
    </dl>
  </section></div>

  <div class="shell"><footer>
    <div class="fmark"><NwatIcon /></div>
    <p class="fmeta">{corporate.offices.join(' · ')}<br>
      &copy; 2026 {corporate.legalName}</p>
  </footer></div>
</main>
</Base>
