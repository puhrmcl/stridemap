---
import Base from '../layouts/Base.astro';
import NwatLockup from '../components/NwatLockup.astro';
import NwatIcon from '../components/NwatIcon.astro';
import OrgChart from '../components/OrgChart.astro';
import Timeline from '../components/Timeline.astro';
import { subsidiaries, corporate } from '../data/entities';
import css from '../styles/corporate.css?raw';

const fonts = `<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Archivo:wdth,wght@75..100,400..700&family=Newsreader:opsz,wght@6..72,300..500&display=swap">`;

const cls = { Operating: 'op', 'In evaluation': 'ev', Concluded: 'di' } as const;
---
<Base
  title="Northwest Ag Technologies"
  description="A technology development company formed in Paullina, Iowa in 2013. Aerial crop science, real estate imaging, freight software, soil fertility, and software development through Verde House."
  css={css}
  fonts={fonts}
  themeColor="#F7F6F1"
>
<nav><div class="navin">
  <a class="navmark" href="/"><NwatLockup /></a>
  <div class="navlinks">
    <a href="#record">Track record</a><a href="#today">Today</a>
    <a href="#structure">Structure</a><a href="#corporate">Corporate</a>
    <a href="#contact">Contact</a>
  </div>
</div></nav>

<main>
  <div class="shell"><header class="hero">
    <p class="label">{corporate.shortName} &middot; formed {corporate.formed}</p>
    <h1>We were measuring photosynthesis from a drone in 2014.</h1>
    <p class="lede">Northwest Ag Technologies builds technology for industries before they get
    around to asking for it. Aerial crop science, real estate imaging, freight dispatch, soil
    fertility, and now software for founders and businesses. Some of it we built because our own
    operations needed it and no one was selling it yet. The pattern has held for over a decade.</p>
  </header></div>

  <div class="shell"><section id="record">
    <div class="sechead"><span class="label">Track record</span>
      <h2>Eight ventures since 2013.</h2>
      <p class="body">Concluded ventures sit alongside operating ones. A company that shows
      only what is still running is harder to assess, not easier &mdash; and the ones that ended
      are where most of what we know came from. Two of the first three were other people&rsquo;s
      software; everything since, we built.</p></div>
    <Timeline />
  </section></div>

  <div class="shell"><section id="today">
    <div class="sechead"><span class="label">Today</span>
      <h2>Three operating companies.</h2>
      <p class="body">Each runs under its own name, serves its own customers, and is accountable
      for its own results. A sampling client, a real estate agent and a software client have no
      reason to meet each other.</p></div>
    <table>
      <thead><tr><th>Company</th><th>Sector</th><th>Principal office</th><th>Status</th></tr></thead>
      <tbody>
        {subsidiaries.map((s) => (
          <tr>
            <td class="nm">{s.href ? <a href={s.href}>{s.name}</a> : s.name}
              {s.note && <span class="note">{s.note}</span>}</td>
            <td>{s.sector}</td>
            <td>{s.office}</td>
            <td><span class={`st ${cls[s.status]}`}>{s.status}</span></td>
          </tr>
        ))}
      </tbody>
    </table>
  </section></div>

  <div class="shell"><section id="structure">
    <div class="sechead"><span class="label">Structure</span>
      <h2>One parent. Independent operating companies beneath it.</h2></div>
    <div class="chartwrap"><OrgChart /></div>
  </section></div>

  <div class="shell"><section id="corporate">
    <div class="sechead"><span class="label">Corporate</span>
      <h2>Entity and offices.</h2></div>
    <dl class="facts">
      <dt>Legal name</dt><dd>{corporate.legalName}</dd>
      <dt>Entity type</dt><dd>{corporate.entityType}</dd>
      <dt>Jurisdiction of formation</dt><dd>{corporate.jurisdiction}</dd>
      <dt>Formed</dt><dd>{corporate.formed}, {corporate.formedAt}</dd>
      <dt>Principal offices</dt><dd>{corporate.offices.join(' · ')}</dd>
      <dt>Registered agent</dt><dd><span class="slot">To be confirmed</span></dd>
    </dl>
  </section></div>

  <div class="shell"><section id="contact">
    <div class="sechead"><span class="label">Contact</span>
      <h2>Corporate enquiries.</h2>
      <p class="body">Business, investor and legal correspondence goes to the general address.
      Anything to do with software reaches Verde House directly.</p></div>
    <dl class="facts">
      <dt>General, investor &amp; legal</dt>
      <dd><a href={`mailto:${corporate.general}`}>{corporate.general}</a></dd>
      <dt>Software — Verde House</dt>
      <dd><a href={`mailto:${corporate.software}`}>{corporate.software}</a></dd>
      <dt>Offices</dt><dd>{corporate.offices.join(' · ')}</dd>
    </dl>
  </section></div>

  <div class="shell"><footer>
    <div class="fmark"><NwatIcon /></div>
    <p class="fmeta">{corporate.offices.join(' · ')}<br>
      &copy; 2026 {corporate.legalName} &middot; formed {corporate.formed}</p>
  </footer></div>
</main>
</Base>
