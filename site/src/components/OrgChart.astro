---
import { subsidiaries, corporate } from '../data/entities';

// Positions are computed, so adding a company to entities.ts widens the chart
// instead of breaking it.
const N = subsidiaries.length;
const GAP = 24;
const BOX_W = 232;
const W = N * BOX_W + (N - 1) * GAP;
const cx = subsidiaries.map((_, i) => i * (BOX_W + GAP) + BOX_W / 2);
const MID = W / 2;
---
<svg class="org" viewBox={`0 0 ${W} 262`} role="img"
     aria-label={`${corporate.legalName} owns ${subsidiaries.map((s) => s.name).join(', ')}`}>
  <g class="rule">
    <line x1={MID} y1="66" x2={MID} y2="106" />
    <line x1={cx[0]} y1="106" x2={cx[N - 1]} y2="106" />
    {cx.map((x) => <line x1={x} y1="106" x2={x} y2="148" />)}
  </g>

  <g class="box parent">
    <rect x={MID - 160} y="0" width="320" height="66" />
    <text x={MID} y="28" class="nm">{corporate.legalName}</text>
    <text x={MID} y="48" class="sub">Parent &middot; {corporate.formed}</text>
  </g>

  {subsidiaries.map((s, i) => (
    <g class={s.status === 'Operating' ? 'box' : 'box pending'}>
      <rect x={cx[i] - BOX_W / 2} y="148" width={BOX_W} height="90" />
      <text x={cx[i]} y="180" class="nm">{s.name}</text>
      <text x={cx[i]} y="200" class="sub">{s.short}</text>
      <text x={cx[i]} y="219" class="sub">{s.office}</text>
    </g>
  ))}
</svg>
