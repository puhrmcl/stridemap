<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleName</key>
	<string>Etch</string>
	<key>CFBundleDisplayName</key>
	<string>Etch</string>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleShortVersionString</key>
	<string>$(MARKETING_VERSION)</string>
	<key>CFBundleVersion</key>
	<string>$(CURRENT_PROJECT_VERSION)</string>
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<!-- Stated explicitly because this target sets GENERATE_INFOPLIST_FILE = NO. With a
	     generated plist Xcode writes this key itself; with a hand-written one the value arrives
	     only if the asset catalog compiler's partial plist merges cleanly, and an App Store
	     upload without it fails validation (ITMS-90713) after archive and export have both
	     succeeded. Naming it here costs nothing and removes the dependency. Must match
	     ASSETCATALOG_COMPILER_APPICON_NAME. -->
	<key>CFBundleIconName</key>
	<string>AppIcon</string>
	<key>UILaunchScreen</key>
	<dict>
		<key>UIColorName</key>
		<string>LaunchBackground</string>
		<key>UIImageName</key>
		<string>LaunchLogo</string>
		<key>UIImageRespectsSafeAreaInsets</key>
		<true/>
	</dict>
	<key>UIUserInterfaceStyleAutomatic</key>
	<true/>
	<key>UISupportedInterfaceOrientations</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
	</array>
	<key>UISupportedInterfaceOrientations~ipad</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationPortraitUpsideDown</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>
	<key>NSLocationWhenInUseUsageDescription</key>
	<string>Etch shows your position on the map so you can see where you've run.</string>
	<key>NSHealthShareUsageDescription</key>
	<string>Etch reads your running workouts and GPS routes from Apple Health to map every run you've taken.</string>
	<key>NSHealthUpdateUsageDescription</key>
	<string>Etch does not write to Apple Health.</string>
	<key>NSPhotoLibraryUsageDescription</key>
	<string>Etch finds photos you took during a run so they can appear with it. Your photos stay on your device.</string>
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleTypeRole</key>
			<string>Editor</string>
			<key>CFBundleURLName</key>
			<string>com.nwagtech.etch.oauth</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>etch</string>
			</array>
		</dict>
	</array>
	<key>LSApplicationQueriesSchemes</key>
	<array>
		<string>strava</string>
	</array>
	<key>ITSAppUsesNonExemptEncryption</key>
	<false/>
</dict>
</plist>
